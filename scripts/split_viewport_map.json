   "module": "render",
   "why": "one of paintGL's passes: axes, guides, the edit box"
  },
  "_draw_previews_after": {
   "module": "render",
   "why": "one of paintGL's passes: the drag's previews"
  },
  "_set_cutout": {
   "module": "render",
   "why": "the face shader's foliage cutout switch, set by the passes"
  },
  "_apply_ambient_occlusion": {
   "module": "render",
   "why": "the ambient occlusion pass of paintGL (#954)"
  },
  "enter_photo": {
   "module": "image_planes",
   "why": "a scene's photo shown behind the model: a placed picture, not geo"
  },
  "apply_photo_camera": {
   "module": "image_planes",
   "why": "the camera of the shown scene photo (enter_photo)"
  },
  "leave_photo": {
   "module": "image_planes",
   "why": "the shown scene photo goes (enter_photo)"
  },
  "_check_photo": {
   "module": "image_planes",
   "why": "the shown scene photo leaves when the camera moves (enter_photo)"
  },
  "_draw_photo_backdrop": {
   "module": "image_planes",
   "why": "draws the shown scene photo behind the model"
  },
  "_draw_photo_in_front": {
   "module": "image_planes",
   "why": "draws the shown scene photo over the model"
  },
  "pick_locked_group": {
   "module": "picking",
   "why": "a pick query (the right-click's way back to a locked group), not an image plane"
  },
  "forget_uploads": {
   "module": "gl_setup",
   "why": "frees a document's GPU uploads, beside reset_document_caches"
  },
  "_snap_context_suffix": {
   "module": "overlay",
   "why": "the ScreenTip text after the snap's name, read by _draw_snap_indicator"
  },
  "edit_group_box_contains_pixel": {
   "module": "overlay",
   "why": "the dotted edit box on screen, beside _edit_group_box_corners"
  },
  "_face_outline_world": {
   "module": "snapping",
   "why": "the face under the cursor for the «Face center» inference"
  },
  "_face_center_under": {
   "module": "snapping",
   "why": "the «Face center» inference"
  },
  "FACE_CENTER_SELECTION_MAX": {
   "module": "snapping",
   "why": "the «Face center» inference's cap"
  },
  "_selected_face_centers": {
   "module": "snapping",
   "why": "the «Face center» points of the selection"
  },
  "_face_centers_near": {
   "module": "snapping",
   "why": "the «Face center» points handed to the snap engine"
  },
  "_face_context_under": {
   "module": "snapping",
   "why": "the snap tip's context for the face under the cursor"
  },
  "_draw_selected_face_centers": {
   "module": "overlay",
   "why": "draws the «Face center» dots, called by the overlay"
  },
  "_first_clear": {
   "module": "occlusion",
   "why": "the first point of a run the view does not hide: an occlusion query"
  },
  "_model_point_at": {
   "module": "projection",
   "why": "pixel to model point, through the frame's depth"
  },
  "_point_at_centre_depth": {
   "module": "projection",
   "why": "pixel to world on the plane through the view's centre"
  },
  "_recentre_on": {
   "module": "interaction",
