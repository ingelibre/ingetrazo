{
 "pr901_source": "a0766383",
 "modules": [
  {
   "module": "interaction",
   "mixin": "InteractionMixin",
   "doc": "Input: tools, cursors, navigation, mouse, wheel, keys and focus."
  },
  {
   "module": "value_input",
   "mixin": "ValueInputMixin",
   "doc": "The typed value buffer (VCB): key handling and value parsing."
  },
  {
   "module": "snapping",
   "mixin": "SnappingMixin",
   "doc": "Snapping and inference: candidate edges and points, centres, locks and the snap refresh."
  },
  {
   "module": "picking",
   "mixin": "PickingMixin",
   "doc": "Picking: the pick index, ray hits and the pick_* queries."
  },
  {
   "module": "occlusion",
   "mixin": "OcclusionMixin",
   "doc": "Screen-depth occlusion for the overlay's annotations and the snap."
  },
  {
   "module": "projection",
   "mixin": "ProjectionMixin",
   "doc": "Pixel and world conversions, rays, work planes and depth reads."
  },
  {
   "module": "group_edit",
   "mixin": "GroupEditMixin",
   "doc": "Group-edit context: entering and leaving a group and how the rest of the model draws."
  },
  {
   "module": "clipboard",
   "mixin": "ClipboardMixin",
   "doc": "Copy, cut and the prototype chunks a clip carries."
  },
  {
   "module": "overlay",
   "mixin": "OverlayMixin",
   "doc": "The 2D QPainter overlay: snap indicator, guides, labels, dimensions and text."
  },
  {
   "module": "sections",
   "mixin": "SectionPlaneMixin",
   "doc": "Section planes: clipping, the cut fill and edges, plane frames and picking."
  },
  {
   "module": "render",
   "mixin": "RenderMixin",
   "doc": "Frame rendering: the paintGL passes, shading, previews, hidden ghosts, hover and silhouettes."
  },
  {
   "module": "instancing",
   "mixin": "InstancingMixin",
   "doc": "Instanced component drawing: placements, prototype draw entries, recorded GL passes."
  },
  {
   "module": "billboards",
   "mixin": "BillboardMixin",
   "doc": "Face-me components and billboards: orientation, meshes, drawing and outlines."
  },
  {
   "module": "chunks",
   "mixin": "ChunkCacheMixin",
   "doc": "Mesh-to-GPU chunk caches: edge and face sync, fingerprints, on-disk cache, culling spans."
  },
  {
   "module": "image_planes",
   "mixin": "ImagePlaneMixin",
   "doc": "Image planes: drawing, outlines and picking of placed images."
  },
  {
   "module": "geo",
   "mixin": "GeoMixin",
   "doc": "Geo-referenced content: base-map tiles, terrain, photo mesh, sky and the geo overlays."
  },
  {
   "module": "shadows",
   "mixin": "ShadowMixin",
   "doc": "Sun shadows: the light frustum, the shadow map and the shadow ground."
  },
  {
   "module": "gl_setup",
   "mixin": "GLSetupMixin",
   "doc": "GL context lifecycle: scene FBO, shader programs, buffers, textures and their release."
  }
 ],
 "support_doc": "Module-level helpers, constants and flags shared by the viewport mixins.",
 "exceptions": {
  "_sync_depth_reach": {
   "module": "gl_setup",
   "why": "tells the camera its depth range each frame, beside _sync_projection"
  },
  "_export_transparent": {
   "module": "gl_setup",
   "why": "render_image's switch for a transparent picture, read where the export sets it"
  },
  "tool_preview": {
   "module": "render",
   "why": "whether paintGL draws the tool's preview (views/multi_view.py)"
  },
  "painting": {
   "module": "render",
   "why": "paintGL's class-wide counter (#1316)"
  },
  "VIEW_STILL_S": {
   "module": "interaction",
   "why": "the hand at rest: how long the view must stay put (view_busy)"
  },
  "_note_camera": {
   "module": "interaction",
   "why": "when the camera last moved, for view_busy"
  },
  "view_busy": {
   "module": "interaction",
   "why": "whether the user is working in the view (drag, pointer, wheel, camera)"
  },
