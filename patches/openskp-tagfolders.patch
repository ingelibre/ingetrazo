diff --git a/packages/python/src/openskp/tagfolders.py b/packages/python/src/openskp/tagfolders.py
new file mode 100644
index 0000000..f2a2390
--- /dev/null
+++ b/packages/python/src/openskp/tagfolders.py
@@ -0,0 +1,84 @@
+"""Native SketchUp tag folder decoding; no SDK dependency."""
+
+import struct
+from collections.abc import Iterator
+from typing import Any
+
+
+def tlv_items(data: bytes) -> Iterator[tuple[str, bytes]]:
+    pos = 0
+    while pos < len(data):
+        if pos + 6 > len(data):
+            raise ValueError("truncated folder TLV header")
+        size = struct.unpack_from("<I", data, pos + 2)[0]
+        end = pos + 6 + size
+        if end > len(data):
+            raise ValueError("truncated folder TLV payload")
+        yield data[pos : pos + 2].hex().upper(), data[pos + 6 : end]
+        pos = end
+
+
+def read_id_list(data: bytes) -> list[int]:
+    ids = []
+    pos = 0
+    while pos < len(data):
+        size = data[pos]
+        pos += 1
+        if not 1 <= size <= 8 or pos + size > len(data):
+            raise ValueError("invalid folder layer ID list")
+        ids.append(int.from_bytes(data[pos : pos + size], "little"))
+        pos += size
+    return ids
+
+
+def parse_vff_folders(data: bytes) -> tuple[list[dict[str, Any]], dict[int, int]]:
+    """Read layer manager 9B3A > implicit root 803E > 833E folders.
+
+    843E carries (byte length, little-endian ID) tag references; nesting
+    gives parentage. 823E and 853E mean hidden/current and hidden/new scenes.
+    """
+    folders: list[dict[str, Any]] = []
+    assignments: dict[int, int] = {}
+
+    def visit(
+        body: bytes,
+        parent: int | None = None,
+        position: int = 0,
+        root: bool = False,
+        depth: int = 0,
+    ) -> None:
+        if depth > 100:
+            raise ValueError("folder nesting exceeds 100")
+        fields = dict(tlv_items(body))
+        ident = None
+        if not root:
+            info = dict(tlv_items(fields.get("DC05", b"")))
+            pid = info.get("DE05")
+            if not pid or len(pid) > 8:
+                raise ValueError("folder has no valid ID")
+            ident = int.from_bytes(pid, "little")
+            if any(f["id"] == ident for f in folders):
+                raise ValueError("duplicate folder ID")
+            folders.append(
+                dict(
+                    id=ident,
+                    name=fields.get("813E", b"").decode("utf-8"),
+                    parent_id=parent,
+                    position=position,
+                    hidden=bool(fields.get("823E", b"\0")[0]),
+                    visible_on_new_scenes=not bool(fields.get("853E", b"\0")[0]),
+                )
+            )
+        for layer in read_id_list(fields.get("843E", b"")):
+            if ident is not None:
+                if layer in assignments:
+                    raise ValueError("layer belongs to more than one folder")
+                assignments[layer] = ident
+        for i, (tag, child) in enumerate(tlv_items(fields.get("833E", b""))):
+            if tag == "803E":
+                visit(child, ident, i, depth=depth + 1)
+
+    for tag, body in tlv_items(data):
+        if tag == "803E":
+            visit(body, root=True)
+    return folders, assignments
diff --git a/packages/python/tests/test_tagfolders.py b/packages/python/tests/test_tagfolders.py
new file mode 100644
index 0000000..d55844c
--- /dev/null
+++ b/packages/python/tests/test_tagfolders.py
@@ -0,0 +1,311 @@
+"""Native folder round trips, plus an optional independent SketchUp oracle.
+
+Set OPENSKP_TEST_SKETCHUP_SDK to a locally licensed SketchUpAPI library.
+No SDK files or SDK-authored model templates are bundled by this test.
+"""
+
+import ctypes as C
+import os
+import struct
+
+import pytest
+from openskp import SkpFile, SkpWriteError, create
+from openskp.tagfolders import parse_vff_folders, read_id_list
+
+
+def tlv(tag, body):
+    return bytes.fromhex(tag) + struct.pack("<I", len(body)) + body
+
+
+def folder_node(ident, name, children=b"", members=b"", hidden=False):
+    return tlv(
+        "803E",
+        tlv("DC05", tlv("DE05", ident.to_bytes(2, "little")))
+        + tlv("813E", name.encode())
+        + tlv("833E", children)
+        + tlv("843E", members)
+        + tlv("823E", bytes([hidden]))
+        + tlv("853E", b"\0"),
+    )
+
+
+def test_vff_folders_use_ids_and_keep_empty_duplicate_names():
+    child = folder_node(513, "Same", members=b"\x02\x04\x02")
+    one = folder_node(512, "Same", children=child, hidden=True)
+    empty = folder_node(514, "Same")
+    raw = tlv("803E", tlv("813E", b"") + tlv("833E", one + empty) + tlv("843E", b""))
+    folders, members = parse_vff_folders(raw)
+    assert [(f["id"], f["parent_id"], f["position"]) for f in folders] == [
+        (512, None, 0),
+        (513, 512, 0),
+        (514, None, 1),
+    ]
+    assert folders[0]["hidden"]
+    assert members == {516: 513}
+
+
+@pytest.mark.parametrize("data", [b"\0", b"\x02\x01", b"\x09" + bytes(9)])
+def test_invalid_id_lists_fail(data):
+    with pytest.raises(ValueError):
+        read_id_list(data)
+
+
+def make_builder():
+    b = create()
+    layer = b.add_layer("Walls", hidden=True)
+    spare = b.add_layer("Empty tag")
+    outer = b.add_layer_folder("Same", hidden=True, visible_on_new_scenes=False)
+    inner = b.add_layer_folder("Same", parent=outer)
+    b.add_layer_folder("Empty")
+    b.set_layer_folder(layer, inner)
+    b.set_layer_folder(spare, outer)
+    with b.add_component_definition("Triangle") as component:
+        component.add_face([(0, 0, 0), (10, 0, 0), (0, 10, 0)], layer=layer)
+    b.add_instance(component, translation=(20, 0, 0))
+    b.add_face([(0, 0, 0), (10, 0, 0), (0, 10, 0)], layer=layer)
+    return b
+
+
+def tree(model):
+    def children(parent):
+        return [
+            (
+                f.name,
+                f.hidden,
+                f.visible_on_new_scenes,
+                sorted(layer.name for layer in model.layers if layer.folder_id == f.id),
+                children(f.id),
+            )
+            for f in model.layer_folders
+            if f.parent_id == parent
+        ]
+
+    return children(None)
+
+
+def test_classic_writer_reader_and_edit_keep_native_folders(tmp_path):
+    from openskp import open_existing
+
+    path = tmp_path / "folders.skp"
+    make_builder().save(str(path))
+    model = SkpFile.open(str(path)).parse()
+    assert tree(model) == [
+        ("Same", True, False, ["Empty tag"], [("Same", False, True, ["Walls"], [])]),
+        ("Empty", False, True, [], []),
+    ]
+    assert (
+        sum(len(d.faces) for d in model.definitions.values()) + len(model.root.faces)
+        == 2
+    )
+    edited = open_existing(str(path))
+    # open_existing returns (builder, definitions, warnings).
+    edited[0].save(str(tmp_path / "edit.skp"))
+    assert tree(SkpFile.open(str(tmp_path / "edit.skp")).parse()) == tree(model)
+
+
+def test_folder_api_rejects_invalid_handles_and_late_mutations():
+    b = create()
+    layer = b.add_layer("Tag")
+    for bad in ("", None):
+        with pytest.raises(SkpWriteError):
+            b.add_layer_folder(bad)
+    with pytest.raises(SkpWriteError):
+        b.add_layer_folder("Folder", parent=100)
+    with pytest.raises(SkpWriteError):
+        b.set_layer_folder(layer, 100)
+    f = b.add_layer_folder("Folder")
+    b.set_layer_folder(layer, f)
+    b.set_layer_folder(layer, None)
+    b.add_face([(0, 0, 0), (10, 0, 0), (0, 10, 0)])
+    with pytest.raises(SkpWriteError):
+        b.add_layer_folder("Late")
+    with pytest.raises(SkpWriteError):
+        b.set_layer_folder(layer, f)
+
+
+class SDK:
+    """Small explicit ctypes binding, confined to local validation."""
+
+    def __init__(self):
+        self.dll = C.CDLL(os.environ["OPENSKP_TEST_SKETCHUP_SDK"])
+        self.dll.SUInitialize()
+
+    def call(self, name, *args):
+        result = getattr(self.dll, name)(*args)
+        assert result == 0, (name, result)
+
+    def ref(self, name, *args):
+        ref = C.c_void_p()
+        self.call(name, C.byref(ref), *args)
+        return ref
+
+    def open(self, path):
+        return self.ref("SUModelCreateFromFile", str(path).encode())
+
+    def refs(self, ref, num, get):
+        count = C.c_size_t()
+        self.call(num, ref, C.byref(count))
+        if not count.value:
+            return []
+        array = (C.c_void_p * count.value)()
+        self.call(get, ref, count, array, C.byref(count))
+        return [C.c_void_p(v) for v in array[: count.value]]
+
+    def name(self, ref, function):
+        string = self.ref("SUStringCreate")
+        try:
+            self.call(function, ref, C.byref(string))
+            size = C.c_size_t()
+            self.call("SUStringGetUTF8Length", string, C.byref(size))
+            buf = C.create_string_buffer(size.value + 1)
+            self.call(
+                "SUStringGetUTF8", string, C.c_size_t(len(buf)), buf, C.byref(size)
+            )
+            return buf.value.decode()
+        finally:
+            self.call("SUStringRelease", C.byref(string))
+
+    def folder_tree(self, parent, root=True):
+        refs = self.refs(
+            parent,
+            "SUModelGetNumLayerFolders" if root else "SULayerFolderGetNumLayerFolders",
+            "SUModelGetLayerFolders" if root else "SULayerFolderGetLayerFolders",
+        )
+        result = []
+        for f in refs:
+            visible, new = C.c_bool(), C.c_bool()
+            self.call("SULayerFolderGetVisibility", f, C.byref(visible))
+            self.call("SULayerGroupGetVisibleOnNewScenes", f, C.byref(new))
+            layers = self.refs(f, "SULayerFolderGetNumLayers", "SULayerFolderGetLayers")
+            result.append(
+                (
+                    self.name(f, "SULayerFolderGetName"),
+                    not visible.value,
+                    new.value,
+                    sorted(self.name(layer, "SULayerGetName") for layer in layers),
+                    self.folder_tree(f, False),
+                )
+            )
+        return result
+
+
+@pytest.fixture
+def sdk():
+    if not os.environ.get("OPENSKP_TEST_SKETCHUP_SDK"):
+        pytest.skip("local SketchUp SDK not configured")
+    sdk = SDK()
+    try:
+        yield sdk
+    finally:
+        sdk.dll.SUTerminate()
+
+
+def test_native_writer_matches_real_sketchup_and_vff_resave(sdk, tmp_path):
+    path = tmp_path / "written.skp"
+    make_builder().save(str(path))
+    expected = tree(SkpFile.open(str(path)).parse())
+    model = sdk.open(path)
+    try:
+        assert sdk.folder_tree(model) == expected
+        entities = C.c_void_p()
+        sdk.call("SUModelGetEntities", model, C.byref(entities))
+        count = C.c_size_t()
+        sdk.call("SUEntitiesGetNumFaces", entities, C.byref(count))
+        assert count.value == 1  # other triangle lives in a component
+        sdk.call("SUEntitiesGetNumInstances", entities, C.byref(count))
+        assert count.value == 1
+        vff = tmp_path / "vff.skp"
+        sdk.call("SUModelSaveToFile", model, str(vff).encode())
+    finally:
+        sdk.call("SUModelRelease", C.byref(model))
+    assert tree(SkpFile.open(str(vff)).parse()) == expected
+
+
+@pytest.mark.parametrize("version", [13, 14])
+def test_sdk_created_folders_are_read_independently(sdk, tmp_path, version):
+    baseline = tmp_path / "baseline.skp"
+    b = create()
+    layer = b.add_layer("Tag")
+    b.add_face([(0, 0, 0), (10, 0, 0), (0, 10, 0)], layer=layer)
+    b.save(str(baseline))
+    model = sdk.open(baseline)
+    path = tmp_path / "sdk.skp"
+    try:
+        outer = sdk.ref("SULayerFolderCreate", "Déjà vu".encode())
+        sdk.call("SUModelAddLayerFolder", model, outer)
+        child = sdk.ref("SULayerFolderCreate", "Déjà vu".encode())
+        sdk.call("SULayerFolderAddLayerFolder", outer, child)
+        sdk.call("SULayerFolderSetVisibility", outer, C.c_bool(False))
+        layers = sdk.refs(model, "SUModelGetNumLayers", "SUModelGetLayers")
+        tag = next(
+            layer for layer in layers if sdk.name(layer, "SULayerGetName") == "Tag"
+        )
+        sdk.call("SULayerFolderAddLayer", child, tag)
+        sdk.call(
+            "SUModelSaveToFileWithVersion", model, str(path).encode(), C.c_int(version)
+        )
+    finally:
+        sdk.call("SUModelRelease", C.byref(model))
+    # The saved file is the oracle; read it again rather than assuming SDK
+    # save preserves every in-memory property on a downgrade.
+    model = sdk.open(path)
+    try:
+        expected = sdk.folder_tree(model)
+    finally:
+        sdk.call("SUModelRelease", C.byref(model))
+    assert tree(SkpFile.open(str(path)).parse()) == expected
+
+
+def test_empty_folder_only_document_and_codegen(tmp_path):
