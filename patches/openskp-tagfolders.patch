+def _read_layer_group(ar: Any, r: Any, implicit: bool = False) -> dict[str, Any]:
+    # Some classic schema-7 managers serialize the implicit root without
+    # a persistent-ID mask; named folder objects still have full preambles.
+    if implicit and r.peek(5) == b'\0\0' + _STR_MARKER:
+        r.raw(2)
+        preamble = {'pid': 0}
+    else:
+        preamble = _preamble(ar, r)
+    name = r.utf16()
+    count = r.u32()
+    if count > 100000:
+        raise LegacyParseError("implausible folder child count")
+    children = [ar.read_object(r, expect='CLayerGroup')[0] for _ in range(count)]
+    count = r.u32()
+    if count > 100000:
+        raise LegacyParseError("implausible folder layer count")
+    layers = [ar.read_object(r, expect='CLayer')[0] for _ in range(count)]
+    hidden = bool(r.u8())
+    marker = _STR_MARKER + bytes([11]) + 'CLayerGroup'.encode('utf-16le')
+    pos = ar.data.find(marker, 0, ar.r.pos)
+    version = struct.unpack_from('<I', ar.data, pos + len(marker))[0] if pos >= 0 else 3
+    return dict(k='layer_folder', name=name, pid=preamble['pid'],
+                children=children, layers=layers, hidden=hidden,
+                visible_on_new_scenes=not bool(r.u8()) if version >= 3 else True)
