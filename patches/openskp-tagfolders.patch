+    def add_layer_folder(self, name: str, parent: Optional[int] = None, hidden: bool = False,
+                         visible_on_new_scenes: bool = True) -> int:
+        """Register a native tag folder. Folder names may repeat.
+
+        Register layers and folders before definitions or root geometry.
+        Files with folders extend the classic container and require
+        SketchUp 2021+ (the first version with tag folders).
+        """
+        if not isinstance(name, str) or not name:
+            raise SkpWriteError("folder name must be a nonempty string")
+        if self._definition_writer is not None or self._geometry_writer is not None:
+            raise SkpWriteError("add_layer_folder must precede geometry and definitions")
+        if parent is not None and (type(parent) is not int or not 0 <= parent < len(self._layer_folders)):
+            raise SkpWriteError("parent must be a folder handle from this builder")
+        handle = len(self._layer_folders)
+        self._layer_folders.append(dict(name=name, parent=parent, hidden=bool(hidden),
+                                       visible_on_new_scenes=bool(visible_on_new_scenes)))
+        return handle
+
+    def set_layer_folder(self, layer: int, folder: Optional[int] = None) -> None:
+        """Move a registered tag into a folder, or to the root (None)."""
+        if self._definition_writer is not None or self._geometry_writer is not None:
+            raise SkpWriteError("set_layer_folder must precede geometry and definitions")
+        if layer not in self.layers_by_name.values():
+            raise SkpWriteError("layer must be a handle from add_layer")
+        if folder is not None and (type(folder) is not int or not 0 <= folder < len(self._layer_folders)):
+            raise SkpWriteError("folder must be a handle from add_layer_folder")
+        if folder is None:
+            self._layer_folder_assignment.pop(layer, None)
+        else:
+            self._layer_folder_assignment[layer] = folder
+
+    def _prepare_folders(self) -> None:
+        if self._folder_writer is not None or not self._layer_folders:
+            return
+        assert self._layer_writer is None or self._layer_writer_start is not None
+        layer_shift = (self._layer_writer.next_slot - (self._layer_writer_start or 0)
+                       if self._layer_writer else 0)
+        material_shift = self._material_writer.next_slot - self._base
+        self._folder_writer_start = self._layer_writer_base + material_shift + layer_shift
+        classes = (dict(self._layer_writer.class_slot) if self._layer_writer
+                   else self._material_shifted_class_slot())
+        w = _ArchiveWriter(next_slot=self._folder_writer_start, class_slot=classes,
+                           next_pid=self._next_pid())
+        def body(record: dict[str, Any], handle: Optional[int]) -> None:
+            w._preamble(pid=0 if handle is None else None)
+            w._write_str(record["name"])
+            kids = [(i, f) for i, f in enumerate(self._layer_folders) if f["parent"] == handle]
+            w.buf += _u32(len(kids))
+            for i, f in kids:
+                w._new_of_known_class("CLayerGroup", schema=3)
+                body(f, i)
+            members = [ly for ly, folder in self._layer_folder_assignment.items() if folder == handle]
+            w.buf += _u32(len(members))
+            for ly in members:
+                w._backref(ly)
+            w.buf += bytes([record["hidden"], not record["visible_on_new_scenes"]])
+        body(dict(name="", hidden=False, visible_on_new_scenes=True), None)
+        self._folder_writer = w
+
     def _layer_shift(self) -> int:
-        if self._layer_writer is None:
