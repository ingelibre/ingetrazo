<mxfile><diagram name="IngeTrazo workflow"><mxGraphModel grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="IngeTrazo – workflow with the demo model" style="text;html=1;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="tree" value="&lt;b&gt;Model Tree (Outliner)&lt;/b&gt;&lt;br&gt;The outliner groups all physical elements of the building in a fixed hierarchy: storey, trade, construction status, element. Each element exists exactly once, and its position in the tree says where it is, who builds it and whether it stays, goes or is new.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: GF › Tiles › Tiles_New › Tiles_new&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="720" height="420" as="geometry"/></mxCell><mxCell id="tree_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="113" y="252" width="223" height="204" as="geometry"/></mxCell><mxCell id="tree_cap0" value="Browser" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="93" y="460" width="263" height="22" as="geometry"/></mxCell><mxCell id="tree_img1" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="429" y="252" width="291" height="204" as="geometry"/></mxCell><mxCell id="tree_cap1" value="Model" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="409" y="460" width="331" height="22" as="geometry"/></mxCell><mxCell id="layer" value="&lt;b&gt;Layers&lt;/b&gt;&lt;br&gt;Layers are switches for visibility and colour. They hang on the containers of the tree, never on single elements, so any combination can be shown or hidden: one storey, one trade, only what is new.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: S_Existing grey · S_Demolition yellow · S_New red&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="70" width="720" height="420" as="geometry"/></mxCell><mxCell id="layer_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="1143" y="252" width="194" height="204" as="geometry"/></mxCell><mxCell id="layer_cap0" value="Layers" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1123" y="460" width="234" height="22" as="geometry"/></mxCell><mxCell id="bim" value="&lt;b&gt;BIM Information&lt;/b&gt;&lt;br&gt;BIM data says what each element is (wall, tiles, furniture) and how much of it there is. Quantities such as areas and volumes are measured from the geometry, so they stay correct when the model changes.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: Tiles_new → IfcCovering, 2.40 m² · Sink cabinet → IfcFurniture&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="720" height="420" as="geometry"/></mxCell><mxCell id="bim_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="219" y="722" width="362" height="204" as="geometry"/></mxCell><mxCell id="bim_cap0" value="BIM ▸ takeoff" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="199" y="930" width="402" height="22" as="geometry"/></mxCell><mxCell id="view" value="&lt;b&gt;Saved Views (Scenes)&lt;/b&gt;&lt;br&gt;A saved view is a reusable picture of the model: camera, visible layers, display style and section. It answers one question, for example “what does the tiler have to do?” or “what is demolished?”.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: V_Tiles (old + new tiles) · V_Kitchen (new kitchen)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="540" width="720" height="420" as="geometry"/></mxCell><mxCell id="view_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="947" y="722" width="235" height="204" as="geometry"/></mxCell><mxCell id="view_cap0" value="Scenes" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="927" y="930" width="275" height="22" as="geometry"/></mxCell><mxCell id="view_img1" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="1269" y="722" width="291" height="204" as="geometry"/></mxCell><mxCell id="view_cap1" value="V_Tiles" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1249" y="930" width="331" height="22" as="geometry"/></mxCell><mxCell id="sheet" value="&lt;b&gt;Sheets&lt;/b&gt;&lt;br&gt;A sheet is a printable page that places one or more saved views at a fixed scale, with a title block and dimensions. Because the frames point to the views, sheets update by themselves.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: Sheet_Tiles = V_Tiles at 1:25 · Sheet_Kitchen = V_Kitchen at 1:25&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="1010" width="720" height="420" as="geometry"/></mxCell><mxCell id="sheet_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="1096" y="1192" width="288" height="204" as="geometry"/></mxCell><mxCell id="sheet_cap0" value="Sheet_Tiles" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1076" y="1400" width="328" height="22" as="geometry"/></mxCell><mxCell id="set" value="&lt;b&gt;Sheet Sets (planned)&lt;/b&gt;&lt;br&gt;A sheet set bundles the sheets one trade or tender needs, in order and with its own cover page. Each trade gets exactly the drawings it needs, and nothing else. Until the feature exists: one sheet folder per trade.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: Set_Tiler = Sheet_Tiles · Set_Kitchen_fitter = Sheet_Kitchen&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="1480" width="720" height="420" as="geometry"/></mxCell><mxCell id="set_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="921" y="1662" width="288" height="204" as="geometry"/></mxCell><mxCell id="set_cap0" value="Set_Tiler" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="901" y="1870" width="328" height="22" as="geometry"/></mxCell><mxCell id="set_img1" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="1271" y="1662" width="288" height="204" as="geometry"/></mxCell><mxCell id="set_cap1" value="Set_Kitchen_fitter" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1251" y="1870" width="328" height="22" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;The output is what leaves the model: one PDF per trade, images for the bill of quantities and lists or IFC files. All of it is generated from the same model, so the documents never contradict each other.&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#1a4d8f&#x27;&gt;Example: Kitchen_fitter.pdf · BoQ: tiles 2.40 m²&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="720" height="420" as="geometry"/></mxCell><mxCell id="out_img0" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="81" y="1662" width="288" height="204" as="geometry"/></mxCell><mxCell id="out_cap0" value="Kitchen_fitter.pdf" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="61" y="1870" width="328" height="22" as="geometry"/></mxCell><mxCell id="out_img1" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;imageBorder=#999999;" vertex="1" parent="1"><mxGeometry x="429" y="1662" width="291" height="204" as="geometry"/></mxCell><mxCell id="out_cap1" value="BoQ image" style="text;html=1;align=center;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="409" y="1870" width="331" height="22" as="geometry"/></mxCell><mxCell id="e0" value="container → layer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="tree" target="layer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="element → attributes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="tree" target="bim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="layers on/off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="layer" target="view"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="frame uses view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="view" target="sheet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="select sheets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="sheet" target="set"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="export set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="set" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="quantities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;fontStyle=2;" edge="1" parent="1" source="bim" target="out"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>